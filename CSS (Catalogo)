@import url('https://fonts.googleapis.com/css2?family=Comic+Neue:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap');
* {
 margin: 0px;
 padding: 0px;
 box-sizing: border-box;
 outline: none;
 font-family: 'Roboto', sans-serif;
}
:root{
  --red: #ff2318;
  --green: #72f514;
  --blue: #3062f9;
}
html, body{
  width:100%;
  overflow-x:hidden;

}
header{
  width:100%;
  height: 500px;
  background:var(--red);
}
.content{
  max-width: 1000px;
  min-width: 300px;
  margin: 0 auto;
  display: flex;
 flex-direction: column;
 padding: 10px;
}
nav{
  width: 100%;
  height: 125px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content:space-between;
}
.brand{
  font-size: 24px;
  color: #fff;
  cursor: pointer;
}
nav ul{
  display: flex;
  flex-direction: row;
}
nav ul li{
  list-style: none;
  padding: 10px;
  cursor: pointer;
}
nav ul li a{
  color:#fff;
  text-decoration: none;
}
nav ul li a:hover{
  color: #d2d2d283;
  font-size:15px;
}
nav ul button{
  border:1px solid var(--green);
  background: transparent;
  padding: 8px 40px;
  cursor: pointer;
  margin-left: 30px;
  color:var(--green);
  font-weight: bold;
  border-radius: 4px;
}
nav ul button:hover{
  transition: background, color, 0.4s;
  background:#72f514;
  color:#fff;
  font-size: 15px;
}
.content .header-block{
  max-width: 1000px;
  min-width: 300px;
  height: 450px;
  background: var(--blue);
  border-radius: 8px;
  box-shadow: 1px 0px 10px 0px rgb(255, 255, 255);
  -webkit-box-shadow: 1px 0px 10px 0px rgb(254, 255, 255);
  -moz-box-shadow: 1px 0px 10px 0px rgb(255, 255, 255);
  position: relative;
  z-index:10;
  padding: 10px;
}
.header-block img{
  width: 30%;
  height: auto;
  position: absolute;
  right: 2%;
  bottom: 7%; 
}
.header-block img:hover{
  cursor:pointer;
   width:300px;
   height: auto;
}

.header-block .text{
  position: absolute;
  bottom: 30%;
  left:15%;
}
.header-block .text h2{
  color:#fff;
  margin-bottom: 20px;
  text-align: left;
  transform: translateX(-20px);
  transition: transform 0.5s;
}
.header-block .text p{
  max-width: 280px;
  color:#fff;
  text-align: left;
  transform: translateX(-20px);
  transition: transform 0.4s;
}
.catalog{
  background: #dbdbdc;
}
section .catalog{
  width: 100vw;
  padding: 100px;
}
section .filter-card{
  width: 980px;
  height: 150px;
  background: var(--blue);
  border-radius: 8px;
  margin: 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.search-input{
  width: 700px;
  height: 50px;
  border:none;
  border-radius: 4px 0px 0px 4px;
  text-indent: 10px;
}
.search-button{
  width: 150px;
  height: 50px;
  border-radius: 0px 4px 4px 0px;
  border: 2px solid var(--green);
  background: transparent;
  color: var(--green);
  cursor: pointer;
  font-size: 1.1em;
  transition: 0.2s ease;
}
.search-button:hover{
  background: #72f514;
  color:#fff;
}
.tittle-wrapper-catalog{
  margin-top: 200px;
  padding-bottom: 20px;
}
section .card-wrapper{
  max-width: 1000px;
  height: 100%;
  display: grid;
  grid-template-columns: repeat(auto-fill,minmax(270px,1fr));
  grid-gap: 30px;
  padding-top: 50px;
}
section .card-item{
  height: 500px;
  background: rgb(177, 176, 176);
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-around;
}
.card-item  button{
  width: 75%;
  padding: 7px 0px;
  border-radius: 4px;
  border: 2px solid var(--red);
  background: transparent;
  color: var(--red);
  font-weight: bold;
  cursor: pointer;
  font-size: 1.1em;
  transition: 0.3s ease;
  margin-bottom: 10px;
}
.card-item button:hover{
  background: var(--red);
  color: #fff;
  font-size: 27px;
}
.card-item img{
  height: 75%;
}
.card-content{
  height: 40%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-around;
}
.card-item h4{
   width: 90%;
}
.card-item p{
  width: 90%;
  font-style: italic;
  color: #000000;
}

.about{
  width: 100%;
  height: 100%;
  color:#fff;
  background: var(--red);
  display:flex;
  align-items: center;
  justify-content: center;
  padding: 50px 10px;
}
.about-content{
  max-width: 1000px;
  min-width: 300px;
  height: 600px;
  background: var(--blue);
  margin: 0 auto;
  border-radius: 8px;
  z-index: 10;
  padding: 10px;
  display:flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.left{
  width: 50%;
  min-width:  300px;
  height: 100%;
  background: var(--red);
  border-radius: 8px;
}
.right{
  width: 65%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  padding-top: 10%;
}
.right h3{
  text-align: right;
  color: #fff;
  width: 90%;
  margin-bottom: 20px;
}
.right p{
  max-width: 90%;
  font-size: 1em;
  letter-spacing: 2px;
  text-align: right;
  color: #fff;
}
.about img{
  width: 100%;
  height: 100%;
}

footer{
  width: 100%;
  height: 250px;
}
footer .main{
  width: 100%;
  height: 200px;
  background: #41414183;
  padding: 20px 10px;
}
.footer-links{
  max-width: 1000px;
  min-width: 300px;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 20px;
}
 .footer-contact, .footer-social{
  color:#3062f9;
  height: 100%;
  min-height: 100px;
}
.footer-links h4{
  margin-bottom: 10px;
}
.footer-links h6{
  margin-bottom: 8px;
}
.main .footer-social{
width: 32px;
height: 32px;
}
footer .last{
  width: 100%;
  height: 50px;
  background: var(--blue);
  color: #fff;
  display:flex;
  align-items: center;
  justify-content: center;
}
.footer-social img{
  width: 100%;
  height: auto;
  display: block;
}
footer img:hover{
  cursor: pointer;
  width: 40px;
  height: auto;
}
.footer-contact h6:hover{
  cursor: pointer;
  color: #122b75;
  font-size: 20px;
}
