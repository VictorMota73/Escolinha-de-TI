<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OLOKO</title>
    <link rel="stylesheet" href="style.css">
    <!--Font-Awesome-->
    <link 
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" 
    integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" 
    crossorigin="anonymous" 
    referrerpolicy="no-referrer" 
    />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin="anonymous"
    />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin="">
    </script>
   
</head>
<body>
    <div class="container">
        <div class="form">
            <h3><strong>CLIMINHA DAS CITY</strong></h3>
            <div class="procurar">
                <input type="text" placeholder="Digite o nome da Cidade" id="CidadeInput">
                <button id="procure">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </div>
       <div id="Clima" class="hide">
        <div id="map"></div>
         <h2>
            <i class="fa-solid fa-location-dot"></i>
            <span id="Cidade"></span>
         </h2>
         <p id="Temperatura"><span></span>&deg;C</p>
         <div id="detalhes-descricao">
            <p id="descricao"></p>
         </div>
         <div id="detalhes-container">
            <p id="umidade">
                 <i class="fa-solid fa-droplet"></i>
                 <span></span>
            </p>
            <p id="vento">
                <i class="fa-solid fa-wind"></i>
                <span></span>
           </p>
         </div>
        </div>
    </div>
</body> 
<script src="script.js"></script>
</html>
