const apikey="Sua Key Aqui";

const Cidadi= document.querySelector("#CidadeInput");
const Procurar= document.querySelector("#procure");
var map=L.map('map');
map.setView([51.505, -0.09], 13);

const elementoCidadi=document.querySelector("#Cidade");
const elementoTemp=document.querySelector("#Temperatura span");
const elementoDesc=document.querySelector("#detalhes-descricao");
const elementoUmidade=document.querySelector("#umidade span");
const elementoVento=document.querySelector("#vento span");
const lindo=document.querySelector("#Clima");

L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{
    maxZoom:19,
    attribution:'&copy; OpenStreetMap contributors'
}).addTo(map);

const Zoom=async(city)=>{
    const resposta=await fetch(
        `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(city)}`
    );
    const data=await resposta.json();
    if(data && data.length>0){
        const boxta=data[0].boundingbox;
        map.fitBounds([
            [parseFloat (boxta[0]),parseFloat (boxta[2])],
            [parseFloat (boxta[1]), parseFloat(boxta[3])]
        ]);
    }
}

const Tacerto=async(city)=>{
    const APIURL=`https://api.openweathermap.org/data/2.5/weather?q=${city}&units=metric&appid=${apikey}&lang=pt_br`;
    const res=await fetch(APIURL)
    const data= await res.json();
   return data;
}
const MostraClima= async(city)=>{
    const data=await Tacerto(city);
    elementoCidadi.innerText= data.name;
    elementoTemp.innerText= parseInt(data.main.temp);
    elementoDesc.innerText= data.weather[0].description;
    elementoUmidade.innerText= `${data.main.humidity}%`;
    elementoVento.innerText= `${data.wind.speed}km/h`;
    lindo.classList.remove("hide");
    setTimeout(() => {
        map.invalidateSize();
    }, 200);
 };

Procurar.addEventListener("click",async (e) => {
    e.preventDefault();
    const city=Cidadi.value;
    await MostraClima(city);
    await Zoom(city);
})
Cidadi.addEventListener("keyup", async (e)=>{
    if(e.code==="Enter"){
        const city=e.target.value;
        await MostraClima(city);
        await Zoom(city);
    }
})
