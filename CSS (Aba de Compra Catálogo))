*{
    margin: 0px;
    padding: 0px;
    box-sizing: border-box;
    outline: none;
    font-family: 'Roboto', sans-serif;
}
:root{
    --red: #ff2318;
    --green: #72f514;
    --blue: #3062f9;
  }
.content{
    background: var(--red);
    padding: 100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
.content .header-block{
    width: 100%;
    height: 600px;
    background: #4848fd;
    border-radius: 8px;
    box-shadow: 1px 0px 10px 0px rgb(68, 255, 0);
    -webkit-box-shadow: 1px 0px 10px 0px rgb(68, 255, 0);
    -moz-box-shadow: 1px 0px 10px 0px rgb(68, 255, 0);
    position: relative;
    z-index:10;
    padding: 10px;
}
.content img{
    width: 30%;
    bottom: 7%; 
    margin-left:10%;
}
.textos button{
    width: 99%;
  padding: 15px 20px;
  border-radius: 4px;
  border-color: #72f514;
  background: transparent;
  color:#72f514 ;
  font-weight: bold;
  cursor: pointer;
  font-size: 1.1em;
  transition: 0.3s ease;
  margin-bottom: auto;
  margin-top: auto;
}
.textos{
   display: flex;
    flex-direction: column;
    justify-content: space-around;
    padding: 4%;
}
.header-block{
    display: flex;
    flex-direction: row-reverse;
    justify-content: left;
    gap: 100px;
}
.textos h2{
     display: flex;
     justify-content: space-between;
     padding:4%;
}
.lindo{
    display: flex;
    justify-content: right;
   padding-top:80px;
   padding-bottom: 25px;
    font-size: 25px;
}
.feio {
    font-size: 10px;
}
button:hover{
transition: background, color, 0.4s;
  background:#72f514;
  color:#fff;
  font-size: 110%;
}
.volta a {
    font-size: 30px;
    display: flex;
    flex-direction: row;
    justify-content: flex-start; 
    text-decoration: none;
    color: white;
    font-weight: bold;
    padding: 10px;
    border-radius: 5px;
    position: fixed; 
    top: 10px;
    left: 10px; 
    transition: background 0.3s ease;
}
.volta p:hover {
    color: #e5e2e283 ;
}
.carinho a {
    display: flex;
    flex-direction: row;
    justify-content: flex-end; 
    text-decoration: none;
    color: white;
    font-weight: bold;
    padding: 10px;
    border-radius: 5px;
    position: fixed; 
    top: 10px;
    left: 10px; 
    transition: background 0.3s ease;
}
.carinho img{
    width: 5%;
    height: auto;
}
.carinho img:hover{
    width: 7%;
    height: auto;
}
